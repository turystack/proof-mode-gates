{
	"name": "@turystack/proof-mode-gates",
	"description": "The gate runner: the delivery ladder, the structural checks the skills bind to, and the report whose verdict is computed rather than declared.",
	"private": false,
	"version": "1.0.0",
	"type": "module",
	"packageManager": "pnpm@10.12.3",
	"sideEffects": false,
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"turystack-proof": "./dist/cli.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=20"
	},
	"files": [
		"dist",
		"templates"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json && node scripts/resolve-aliases.mjs",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:cov": "vitest run --coverage",
		"lint": "biome lint ./src",
		"check": "biome check ./src",
		"check:fix": "biome check --write ./src",
		"prepack": "pnpm run build"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/turystack/proof-mode-gates.git"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.4",
		"@types/node": "^24.0.0",
		"@vitest/coverage-v8": "^4.1.10",
		"typescript": "^7.0.2",
		"vite": "^8.1.5",
		"vitest": "^4.1.10"
	}
}
